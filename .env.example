# Onkai Studio - Public Environment Configuration
# Only genuinely public configuration should use NEXT_PUBLIC_*

# Canonical site domain
NEXT_PUBLIC_SITE_URL=https://onkai.studio

# Optional public analytics measurement ID (only initialized with explicit user consent)
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Server-only configurations (never prefixed with NEXT_PUBLIC_)
# Optional mail provider secret for production contact dispatch:
# CONTACT_EMAIL_RECIPIENT=hello@onkai.studio
# RESEND_API_KEY=
